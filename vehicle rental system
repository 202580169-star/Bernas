using System;
using System.Collections.Generic;

namespace VehicleRentalSystem
{
    class Vehicle
    {
        protected string vehicleId;
        protected string brand;
        protected double dailyRate;

        public Vehicle(string vehicleId, string brand, double dailyRate)
        {
            this.vehicleId = vehicleId;
            this.brand = brand;
            this.dailyRate = dailyRate;
        }

        public virtual double CalculateRentalCost(int days)
        {
            return dailyRate * days;
        }

        public virtual void DisplayInfo()
        {
            Console.WriteLine(
                $"Vehicle [ID={vehicleId}, Brand={brand}]");
        }
    }

    class Car : Vehicle
    {
        private int numSeats;

        public Car(string id, string brand, double rate, int seats)
            : base(id, brand, rate)
        {
            numSeats = seats;
        }

        public override double CalculateRentalCost(int days)
        {
            return dailyRate * days * 1.10;
        }

        public override void DisplayInfo()
        {
            Console.Write(
                $"Car [ID={vehicleId}, Brand={brand}, Seats={numSeats}]");
        }
    }

    class Motorcycle : Vehicle
    {
        private int engineCapacity;

        public Motorcycle(
            string id, string brand, double rate, int cc)
            : base(id, brand, rate)
        {
            engineCapacity = cc;
        }

        public override double CalculateRentalCost(int days)
        {
            return dailyRate * days * 0.95;
        }

        public override void DisplayInfo()
        {
            Console.Write(
                $"Motorcycle [ID={vehicleId}, Brand={brand}, CC={engineCapacity}]");
        }
    }

    class Customer
    {
        private string name;
        private string licenseNumber;
        private Vehicle? rentedVehicle;

        public Customer(string name, string licenseNumber)
        {
            this.name = name;
            this.licenseNumber = licenseNumber;
            rentedVehicle = null;
        }

        public void RentVehicle(Vehicle vehicle)
        {
            rentedVehicle = vehicle;
        }

        public void ReturnVehicle()
        {
            rentedVehicle = null;
            Console.WriteLine("Vehicle returned successfully.");
        }

        public void PrintRentalSummary(int days)
        {
            Console.WriteLine("\n=== Customer Rental Summary ===");
            Console.WriteLine(
                $"Customer: {name} (License: {licenseNumber})");

            if (rentedVehicle != null)
            {
                Console.Write("Rented: ");
                rentedVehicle.DisplayInfo();

                double totalCost =
                    rentedVehicle.CalculateRentalCost(days);

                Console.WriteLine(
                    $"\nTotal Cost for {days} days: ${totalCost:F2}");
            }
            else
            {
                Console.WriteLine("No vehicle is currently rented.");
            }
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Car car = new Car("101", "Toyota", 100, 5);

            Motorcycle motorcycle =
                new Motorcycle("102", "Yamaha", 50, 150);

            List<Vehicle> vehicles = new List<Vehicle>
            {
                car,
                motorcycle
            };

            Console.WriteLine("=== Vehicle Rental Costs ===");

            foreach (Vehicle vehicle in vehicles)
            {
                vehicle.DisplayInfo();

                double cost = vehicle.CalculateRentalCost(3);

                Console.WriteLine(
                    $" -> Cost for 3 days: ${cost:F2}");
            }

            Customer customer = new Customer("Alice", "AB1234");

            Car rentedCar = new Car("103", "Toyota", 100, 5);

            customer.RentVehicle(rentedCar);

            customer.PrintRentalSummary(5);
        }
    }
}
